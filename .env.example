# ============================================================
# TempPad — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# --- Required ---
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local dev:
DATABASE_URL=postgresql://temppad_user:your_password_here@localhost:5432/temppad

# --- Optional (defaults shown) ---

# Port the Express server listens on
PORT=3000

# Node environment: "development" or "production"
NODE_ENV=development

# For production behind a reverse proxy (Render, Railway, etc.),
# set to 1 so Express trusts the X-Forwarded-For header for rate limiting.
# See: https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=0

# File time-to-live in seconds. Default: 86400 (24 hours).
# Change ONLY for testing (e.g., 60 for 1 minute). Document clearly.
FILE_TTL_SECONDS=86400

# How often the cleanup job runs, in milliseconds. Default: 300000 (5 min).
CLEANUP_INTERVAL_MS=300000

# Allowed CORS origin. Leave empty to disallow cross-origin requests.
# Set to a specific origin (e.g., https://temppad.example.com) if the
# frontend is hosted separately from the backend.
CORS_ORIGIN=

# PostgreSQL SSL: set to "true" for managed databases (Render, Neon, Supabase).
# This adds { ssl: { rejectUnauthorized: false } } to the pg pool config.
DB_SSL=false
